<!-- 全局字号（键名规范：*FontSize），KeyInputEnabled 控制键盘输入可用性 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:Double x:Key="LargeFontSize">18</system:Double>
    <system:Double x:Key="HeadFontSize">16</system:Double>
    <system:Double x:Key="SubHeaderFontSize">14</system:Double>
    <system:Double x:Key="TextFontSize">12</system:Double>
    <system:Double x:Key="HeaderMenuFontSize">22</system:Double>
    <system:Boolean x:Key="KeyInputEnabled">false</system:Boolean>
</ResourceDictionary>