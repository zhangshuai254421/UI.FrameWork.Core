    <Thickness x:Key="Framework_MainMargin">5 0</Thickness>
    <Thickness x:Key="Framework_PageMargin">15 0</Thickness>
    <Thickness x:Key="Framework_CoverPageMargin">15</Thickness>
    <Thickness x:Key="Framework_BottomMargin">0 0 15 0</Thickness>

    <system:Double x:Key="ButtonWidth">100</system:Double>
