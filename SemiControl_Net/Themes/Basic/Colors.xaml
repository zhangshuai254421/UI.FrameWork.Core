<!--
    主题颜色定义（全库画笔的取色源头，键名规范：*Color）。
    分层约定：Primary 主色系 / Secondary 辅助色系 / Background 背景色系 /
    Thirdly 三级色系 / Border 边框色系 / Text 文字色系 / 状态色（Warning 红、Normal 绿、Hover）。
    调主题只需改本文件；Brushes.xaml 中的画笔经 DynamicResource 联动刷新。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===== 主色系（Primary：品牌主色及其深/浅/工具变体） ===== -->
    <Color x:Key="PrimaryColor">#2561a9</Color>
    <Color x:Key="PrimaryDeepColor">#2b4269</Color>
    <Color x:Key="PrimaryToolColor">#1e4e8d</Color>
    <Color x:Key="PrimaryLightColor">#448ec9</Color>
    <Color x:Key="PrimaryLightToolColor">#509cd8</Color>
    <Color x:Key="PrimaryDefaultColor">#ffffff</Color>
    <Color x:Key="PrimaryDeepToolColor">#2561a9</Color>
    <!--主辅深色（添加）-->
    <Color x:Key="PrimaryControlToolColor">#bbc2cc</Color>
    <!--主辅控件色（添加）-->

    <!-- ===== 辅助色系（Secondary） ===== -->
    <Color x:Key="SecondaryDeepColor">#8994a1</Color>
    <Color x:Key="SecondaryColor">#bbc2cc</Color>
    <Color x:Key="SecondaryLightColor">#d7dde4</Color>

    <!-- ===== 背景色系（Background） ===== -->
    <Color x:Key="BackgroundDeepColor">#e1e1e1</Color>
    <Color x:Key="BackgroundColor">#f0f3f6</Color>
    <Color x:Key="BackgroundLightColor">#fafafa</Color>
    <Color x:Key="BackgroundLightToolColor">#1E90FF</Color>

    <!-- ===== 三级色系（Thirdly） ===== -->
    <Color x:Key="ThirdlyDeepColor">#5b81a0</Color>
    <Color x:Key="ThirdlyColor">#729bbc</Color>
    <Color x:Key="ThirdlyLightColor">#f4f5f6</Color>
    <Color x:Key="ThirdlyLightToolColor">#e5e5ef</Color>

    <!-- ===== 悬停色 ===== -->
    <Color x:Key="HoverColor">#ccdfeb</Color>

    <!-- ===== 边框色系（Border） ===== -->
    <Color x:Key="PrimaryBorderColor">#b0b9c4</Color>
    <Color x:Key="BorderColor">#b4b4b4</Color>
    <Color x:Key="SecondaryBorderColor">#dae7ed</Color>

    <!-- ===== 文字色系（Text） ===== -->
    <Color x:Key="SpecialTextColor">#448ec9</Color>
    <Color x:Key="PrimaryTextColor">#505050</Color>
    <Color x:Key="TextColor">#5f5f5f</Color>
    <Color x:Key="SecondaryTextColor">#969696</Color>
    <Color x:Key="DisableTextColor">#b4b4b4</Color>
    <Color x:Key="MenuTextColor">#323232</Color>
    <!--新添-->

    <!-- ===== 状态色（警告红 / 正常绿） ===== -->
    <Color x:Key="WarningColor">#b30c0d</Color>
    <Color x:Key="WarningToolColor">#f68484</Color>
    <Color x:Key="NormalColor">#128a3b</Color>
    <Color x:Key="NormalToolColor">#a4eaad</Color>
</ResourceDictionary>