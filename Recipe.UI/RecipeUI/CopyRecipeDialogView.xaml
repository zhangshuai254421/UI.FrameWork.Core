<UserControl x:Class="Recipe.UI.RecipeUI.CopyRecipeDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Recipe.UI.RecipeUI"
             xmlns:mw="https://github.io/semicontrol"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="480"
             MinWidth="420" MinHeight="240">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 标题文本样式 -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- 标签文本样式 -->
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <!-- 确认按钮样式 -->
        <Style x:Key="DialogConfirmButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按钮样式 -->
        <Style x:Key="DialogCancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ═══ 弹框主容器 ═══ -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource PrimaryBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="24,20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="拷贝新配方"
                       Style="{StaticResource DialogTitleStyle}"/>

            <!-- 分隔线 -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource PrimaryBorderBrush}"
                    Margin="0,0,0,16"
                    Opacity="0.3"/>

            <!-- 原配方名（只读显示） -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="原配方名:"
                           Style="{StaticResource DialogLabelStyle}"/>

                <Border Grid.Column="1"
                        Opacity="0.15"
                        CornerRadius="4"
                        Padding="10,7">
                    <TextBlock Text="{Binding OriginalRecipeName}"
                               IsEnabled="False"
                               Foreground="Black"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 新配方名（可编辑输入框） -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="新配方名:"
                           Style="{StaticResource DialogLabelStyle}"/>

                <TextBox Grid.Column="1"
                         Text="{Binding NewRecipeName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         BorderBrush="{DynamicResource PrimaryBorderBrush}"
                         BorderThickness="1"
                         Background="{DynamicResource CardBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryBrush}"
                         SelectionBrush="{DynamicResource PrimaryBrush}">
                </TextBox>
            </Grid>

            <!-- 错误提示 -->
            <TextBlock Grid.Row="4"
                       Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="#E84A4A"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="80,4,0,0"/>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="确认"
                        Style="{StaticResource DialogConfirmButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,10,0"/>
                <Button Content="取消"
                        Style="{StaticResource DialogCancelButtonStyle}"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>