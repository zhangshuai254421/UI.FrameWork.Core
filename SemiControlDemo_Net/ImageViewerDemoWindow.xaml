<Window x:Class="SemiControlDemo_Net.ImageViewerDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiControlDemo_Net"
        xmlns:semicontrol="https://github.io/semicontrol"
        mc:Ignorable="d"
        Title="SemiControl Demo — ImageViewer 图像查看控件演示"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🖼 ImageViewer 图像查看控件演示"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1A1A1A"
                       VerticalAlignment="Center"/>
            <TextBlock Text="左键：拖框移动框、空白处拖动平移；右键菜单画标注/ROI；滚轮缩放、双击切换适应/1:1"
                       FontSize="13" Foreground="#888"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="btnStream" Content="▶ 开始模拟流（1280×1024 @30fps）"
                    Padding="8,4" Margin="0,0,12,4" Click="BtnStream_Click"/>
            <Button Content="模拟检测结果" Padding="8,4" Margin="0,0,12,4" Click="BtnInjectResults_Click"/>
            <Button Content="清除标注" Padding="8,4" Margin="0,0,12,4" Click="BtnClearAnnotations_Click"/>
            <Button Content="清除 ROI" Padding="8,4" Margin="0,0,12,4" Click="BtnClearRoi_Click"/>
            <Button Content="适应窗口" Padding="8,4" Margin="0,0,12,4" Click="BtnFit_Click"/>
            <Button Content="1:1" Padding="8,4" Margin="0,0,12,4" Click="BtnActualSize_Click"/>
            <CheckBox x:Name="chkCrosshair" Content="中心十字线"
                      Margin="0,0,12,4" VerticalAlignment="Center"
                      Checked="ChkCrosshair_Changed" Unchecked="ChkCrosshair_Changed"/>
        </WrapPanel>

        <!-- 图像查看控件：合并了 App 级 Skin.xaml 后隐式样式自动生效 -->
        <semicontrol:ImageViewer x:Name="viewer" Grid.Row="2" MinHeight="400"/>

        <!-- 状态栏：ROI 事件回显 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="ROI（RoiRect 事件回显）：" VerticalAlignment="Center" FontSize="12" Foreground="#666"/>
            <TextBlock x:Name="txtRoi" Text="无"
                       VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
