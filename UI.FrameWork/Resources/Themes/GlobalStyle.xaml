<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="https://github.io/semicontrol">
    
    <Style x:Key="MainButtonStyle" TargetType="s:IconButton" BasedOn="{StaticResource IconButtonBaseStyle}">
        <Setter Property="Width" Value="160"/>
        <Setter Property="Height" Value="150"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="IconHeight" Value="70"/>
        <Setter Property="IconWidth" Value="55"/>
        <Setter Property="s:BorderElement.CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DefaultButton_DefaultBackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultButton_DefaultBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultButton_DefaultTextBrush}"/>
    </Style>


    <Style x:Key="FooterButtonStyle" TargetType="s:IconButton" BasedOn="{StaticResource IconButtonBaseStyle}">
        <Setter Property="Width" Value="75"/>
        <Setter Property="Height" Value="75"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="IconWidth" Value="100"/>
        <Setter Property="s:BorderElement.CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DefaultButton_DefaultBackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultButton_DefaultBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultButton_DefaultTextBrush}"/>
    </Style>

    <!-- 隐式 ListView / ListViewItem 样式（空）：HandyControl 3.5.1 给 ListView 的隐式模板是 Border 包 hc:Empty 占位——
         没有 ItemsPresenter，条目永不显示（报警测试页两清单一直空的根子）；其隐式 ListViewItem 模板里还有
         碰冻结背景刷的路径动画，条目一实例化就抛 XamlParseException。空样式不设任何属性，控件回落
         WPF 主题默认模板，条目照常生成；ListBox 的 HandyControl 定制不受影响。 -->
    <Style TargetType="ListView"/>
    <Style TargetType="ListViewItem"/>
</ResourceDictionary>