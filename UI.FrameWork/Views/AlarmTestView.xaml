<UserControl x:Class="SemiAppliaction.Views.AlarmTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:alarmUI="clr-namespace:Framework.Alarm.UI;assembly=Framework.Alarm.UI"
             xmlns:controls="https://github.io/semicontrol"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <!-- 报警测试页：宿主的演示装置页。家族正式视图（AlarmListView）原样嵌入，
         本页只叠一层模拟操作条（开始/停止剧本）。报警的呈现与判定全在家族里，
         宿主不复制一份列表模板——这正是家族封装要防的（仿 Recipe.UI 的可选家族） -->
    <controls:LayoutPageControl IsRightPanelVisible="False">

        <controls:LayoutPageControl.MainContent>
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 模拟操作条：演示装置（AlarmDemo）每秒推一步剧本投喂真引擎 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="开始模拟" Padding="16,4" Margin="0,0,8,0" Command="{Binding StartCommand}"/>
                    <Button Content="停止模拟" Padding="16,4" Margin="0,0,16,0" Command="{Binding StopCommand}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 家族正式视图：DataContext 直接给列表 VM（导航路径下由 Prism 配对，嵌入路径下在这里注入） -->
                <alarmUI:AlarmListView Grid.Row="1" DataContext="{Binding List}"/>
            </Grid>
        </controls:LayoutPageControl.MainContent>

        <!-- 底部工具栏 -->
        <controls:LayoutPageControl.ToolBoxContent>
            <Grid/>
        </controls:LayoutPageControl.ToolBoxContent>

    </controls:LayoutPageControl>

</UserControl>
