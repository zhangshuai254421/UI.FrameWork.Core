<UserControl x:Class="SemiAppliaction.Views.CameraTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SemiAppliaction.Views"
             xmlns:controls="https://github.io/semicontrol"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <!-- 相机测试页：真实相机连续取流喂 ImageViewer，测控件的实时显示与全部交互 -->
    <controls:LayoutPageControl IsRightPanelVisible="False">

        <!-- ═══ 主区域 ═══ -->
        <controls:LayoutPageControl.MainContent>
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 操作条 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="开始取流" Padding="16,4" Margin="0,0,8,0" Command="{Binding StartCommand}"/>
                    <Button Content="停止取流" Padding="16,4" Margin="0,0,8,0" Command="{Binding StopCommand}"/>
                    <Button Content="模拟检测结果" Padding="16,4" Margin="0,0,8,0" Command="{Binding InjectResultCommand}"/>
                    <Button Content="清除结果" Padding="16,4" Margin="0,0,16,0" Command="{Binding ClearResultsCommand}"/>
                    <CheckBox Content="中心十字线" VerticalAlignment="Center" IsChecked="{Binding IsCenterCrosshair}"/>
                </StackPanel>

                <!-- 图像查看控件：滚轮缩放、左键智能键（拖框/平移）、右键菜单画 ROI 与标注 -->
                <controls:ImageViewer Grid.Row="1"
                                      Frame="{Binding Frame}"
                                      Results="{Binding Results}"
                                      IsCenterCrosshair="{Binding IsCenterCrosshair}"/>

                <!-- 状态条 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="状态："/>
                    <TextBlock Text="{Binding StatusText}" Margin="4,0,16,0"/>
                    <TextBlock Text="帧率："/>
                    <TextBlock Text="{Binding Fps}" Margin="4,0,2,0"/>
                    <TextBlock Text="fps"/>
                </StackPanel>
            </Grid>
        </controls:LayoutPageControl.MainContent>

        <!-- ═══ 底部工具栏 ═══ -->
        <controls:LayoutPageControl.ToolBoxContent>
            <Grid/>
        </controls:LayoutPageControl.ToolBoxContent>

    </controls:LayoutPageControl>

</UserControl>
