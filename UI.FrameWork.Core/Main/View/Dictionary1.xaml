<!-- Themes/Generic.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  
                    xmlns:system="clr-namespace:System;assembly=System.Runtime" xmlns:control="https://github.io/semicontrol">

    <!-- 底部区域高度资源（保持与原代码一致） -->
    <system:Double x:Key="Framework_BottomHeight">180</system:Double>

    <Style
				TargetType="{x:Type control:IconButton}"
				BasedOn="{StaticResource IconButtonBaseStyle}"
				x:Key="RightButtonStyle">
        <Setter
					Property="Width"
					Value="140" />
        <Setter
					Property="Height"
					Value="75" />
        <Setter
					Property="Margin"
					Value="0,0,10,0" />
        <Setter
					Property="HorizontalAlignment"
					Value="Right" />
        <Setter
					Property="FontSize"
					Value="18" />
        <Setter
					Property="BorderBrush"
					Value="#fff" />
        <Setter
					Property="BorderThickness"
					Value="1" />
        <Setter
					Property="control:BorderElement.CornerRadius"
					Value="10" />
        <Setter
					Property="FontFamily"
					Value="arial" />
    </Style>
    <Style TargetType="{x:Type control:LayoutPageControl}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type control:LayoutPageControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="PART_RightColumn" Width="165"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ===== 主区域 ===== -->
                        <Border x:Name="PART_MainBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                BorderBrush="{DynamicResource PrimaryControlToolBrush}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_MainArea"
                                              Content="{TemplateBinding MainContent}"/>
                        </Border>

                        <!-- ===== 右侧区域 ===== -->
                        <Border x:Name="PART_RightBorder"
                                Grid.Row="0"
                                Grid.Column="1"
                                BorderBrush="{DynamicResource PrimaryControlToolBrush}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_RightArea"
                                              Content="{TemplateBinding RightContent}"/>
                        </Border>

                        <!-- ===== 底部工具栏（跨 2 列） ===== -->
                        <Border x:Name="PART_FooterBorder"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                BorderBrush="{DynamicResource PrimaryControlToolBrush}"
                                BorderThickness="0 2 0 0"
                                 Height="{DynamicResource Framework_BottomHeight}" 
                                SnapsToDevicePixels="True">
                            <Border Height="178">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="165"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 工具区域（底部左侧） -->
                                    <ContentPresenter x:Name="PART_ToolBoxArea"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding ToolBoxContent}"/>

                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- 右侧面板显隐逻辑已移至 LayoutPageControl.cs 的 ApplyRightPanelVisibility() -->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
