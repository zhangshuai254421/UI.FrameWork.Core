<!-- Themes/Generic.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UI.FrameWork.Core.Main.View"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- 底部区域高度资源（保持与原代码一致） -->
    <system:Double x:Key="Framework_BottomHeight">180</system:Double>

    <Style TargetType="{x:Type local:LayoutPageControl}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LayoutPageControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ===== 主区域 ===== -->
                        <Border x:Name="PART_MainBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                BorderBrush="{DynamicResource PrimaryControlToolBrush}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_MainArea"
                                              Content="{TemplateBinding MainContent}"/>
                        </Border>

                        <!-- ===== 右侧区域 ===== -->
                        <Border x:Name="PART_RightBorder"
                                Grid.Row="0"
                                Grid.Column="1"
                                BorderBrush="{DynamicResource PrimaryControlToolBrush}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_RightArea"
                                              Content="{TemplateBinding RightContent}"/>
                        </Border>

                        <!-- ===== 底部工具栏（跨 2 列） ===== -->
                        <Border x:Name="PART_FooterBorder"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                BorderBrush="{DynamicResource PrimaryControlToolBrush}"
                                BorderThickness="0 2 0 0"
                                 Height="{DynamicResource Framework_BottomHeight}" 
                                SnapsToDevicePixels="True">
                            <Border Height="178">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="165"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 工具区域（底部左侧） -->
                                    <ContentPresenter x:Name="PART_ToolBoxArea"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding ToolBoxContent}"/>

                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 右侧面板隐藏时：主区域跨 2 列 -->
                        <DataTrigger Binding="{Binding IsRightPanelVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                     Value="False">
                            <Setter TargetName="PART_MainBorder"
                                    Property="Grid.ColumnSpan" Value="2"/>
                            <Setter TargetName="PART_RightBorder"
                                    Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
