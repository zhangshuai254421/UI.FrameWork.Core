<UserControl x:Class="UI.FrameWork.Core.Main.Footer.LogShowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.FrameWork.Core.Main.Footer"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="1100">
    <Grid>
        <ScrollViewer x:Name="LogScrollViewer"
                      Margin="5"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <RichTextBox x:Name="LogRichTextBox"
                         Background="{DynamicResource PrimaryControlToolBrush}"                         
                         Foreground="Black"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="14"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"
                         IsReadOnly="True"
                         BorderThickness="0" />
        </ScrollViewer>
    </Grid>
</UserControl>
