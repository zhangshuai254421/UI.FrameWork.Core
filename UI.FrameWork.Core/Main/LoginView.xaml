<Window x:Class="UI.FrameWork.Core.Main.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:UI.FrameWork.Core.Main"
        xmlns:mvvm="http://prismlibrary.com/"
        mc:Ignorable="d"
        mvvm:ViewModelLocator.AutoWireViewModel="True"
        Title="系统登录"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- 密码框 Placeholder 附加属性 -->
        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="CaretBrush" Value="#2561a9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="#d0d5dd"
                                BorderThickness="0,0,0,1"
                                Padding="4,8">
                            <Grid>
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#999"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2561a9"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 密码框样式 -->
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="CaretBrush" Value="#2561a9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="#d0d5dd"
                                BorderThickness="0,0,0,1"
                                Padding="4,8">
                            <Grid>
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#999"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2561a9"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 登录按钮样式 -->
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#2561a9"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e4e8d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a3f73"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#a0b8d8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器：带圆角和阴影的窗口 -->
    <Border CornerRadius="12" Background="#ffffff"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 左侧品牌区 -->
                <ColumnDefinition Width="360"/>
                <!-- 右侧登录表单区 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左侧：品牌展示区 ==================== -->
            <Border Grid.Column="0" CornerRadius="12,0,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1a3f73" Offset="0"/>
                        <GradientStop Color="#2561a9" Offset="0.5"/>
                        <GradientStop Color="#1e4e8d" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <!-- Logo 容器 -->
                        <Border Width="80" Height="80"
                                Background="#ffffff"
                                CornerRadius="20"
                                Margin="0,0,0,20">
                            <Image Source="/UI.FrameWork.Core;component/Resources/zs.png"
                                   Width="48" Height="48"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="SemiControl"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#ffffff"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI, Microsoft YaHei"/>

                        <TextBlock Text="工业设备控制系统"
                                   FontSize="14"
                                   Foreground="#c0d4f0"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   FontFamily="Microsoft YaHei"/>

                        <!-- 分隔线 -->
                        <Border Height="1"
                                Width="40"
                                Background="#4070b0"
                                Margin="0,24,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 右侧：登录表单 ==================== -->
            <Grid Grid.Column="1" Margin="60,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Width="300" HorizontalAlignment="Center">

                    <!-- 标题 -->
                    <TextBlock Text="欢迎登录"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1a1a1a"
                               Margin="0,0,0,8"
                               FontFamily="Microsoft YaHei"/>

                    <TextBlock Text="请输入您的账户信息"
                               FontSize="14"
                               Foreground="#888"
                               Margin="0,0,0,32"
                               FontFamily="Microsoft YaHei"/>

                    <!-- 用户名 -->
                    <TextBlock Text="用户名"
                               FontSize="13"
                               Foreground="#555"
                               Margin="0,0,0,6"
                               FontFamily="Microsoft YaHei"/>
                    <TextBox x:Name="txtUsername"
                             Style="{StaticResource LoginTextBox}"
                             Tag="请输入用户名"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20"/>

                    <!-- 密码 -->
                    <TextBlock Text="密码"
                               FontSize="13"
                               Foreground="#555"
                               Margin="0,0,0,6"
                               FontFamily="Microsoft YaHei"/>
                    <PasswordBox x:Name="txtPassword"
                                 Style="{StaticResource LoginPasswordBox}"
                                 Tag="请输入密码"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="0,0,0,8"/>

                    <!-- 错误提示 -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#e74c3c"
                               FontSize="13"
                               HorizontalAlignment="Left"
                               Margin="0,4,0,0"
                               FontFamily="Microsoft YaHei"/>

                    <!-- 登录按钮 -->
                    <Button Content="登  录"
                            Style="{StaticResource LoginButton}"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=txtPassword}"
                            Margin="0,28,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

</Window>

