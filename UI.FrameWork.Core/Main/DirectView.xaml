        </s:IconButton>
        <s:IconButton Grid.Row="3" Grid.Column="11" IconGeometry="{StaticResource MainMenuSmall3Geometry}"  Style="{StaticResource BottomButtonSmallStyle}" TopLeftContent="" Content="记录分析">
          
