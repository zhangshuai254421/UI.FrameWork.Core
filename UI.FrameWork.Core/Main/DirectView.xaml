            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.Column="1" >
            <s:IconButton  IconGeometry="{StaticResource MainMenu1Geometry}" Style="{StaticResource BottomButtonStyle}" IsShowStatus="True" Content="刀片测高" 
                   >
     
