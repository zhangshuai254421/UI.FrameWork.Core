        <s:IconButton Grid.Row="1" Grid.Column="11" IconGeometry="{StaticResource MainMenuSmall1Geometry}" Style="{StaticResource BottomButtonSmallStyle}" TopLeftContent="" Content="操作记录" >
        
        </s:IconButton>
        <s:IconButton Grid.Row="1" Grid.Column="13" IconGeometry="{StaticResource MainMenuSmall2Geometry}" Style="{StaticResource BottomButtonSmallStyle}" TopLeftContent="" Content="截图" IconWidth="100" />

        <s:IconButton  Grid.Row="3" Grid.Column="1" IconGeometry="{StaticResource MainMenu6Geometry}"  IsShowStatus="True" Content="系统初始化" Style="{StaticResource BottomButtonStyle}">
          
