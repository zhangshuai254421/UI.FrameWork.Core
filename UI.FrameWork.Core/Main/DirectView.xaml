        <Button Grid.Row="1" Grid.Column="15" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="35" Background="Transparent" BorderThickness="0" >
            <Path Width="15" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M939.42628788 507.35523619l-427.42628788 436.71581549 4.64476381-859.49733956z" Stretch="Fill" Fill="#1f2e54"/>
